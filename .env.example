# Required to create accounts at /signup. Generate a long random value.
FKEY_SIGNUP_CODE=replace-with-a-long-random-code

# Central account database and per-user SQLite files live below this directory.
FKEY_DATA_DIR=data

# Required behind a tunnel or reverse proxy. Use the public origin, without /mcp.
# FKEY_PUBLIC_URL=https://fkey.example.com

# Optional on the host; Docker Compose sets this to its Redis service.
# Auth rate limiting is enabled whenever this is set.
# FKEY_REDIS_URL=redis://127.0.0.1:6379/0

# Trust CF-Connecting-IP/X-Forwarded-For only behind a proxy you control.
# Docker Compose is loopback-only and enables this for the local tunnel workflow.
# FKEY_TRUST_PROXY_HEADERS=false
